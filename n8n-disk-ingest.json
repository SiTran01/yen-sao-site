      "name": "Đọc File JSON",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [ 220, 0 ]
    },
    {
      "parameters": {
        "jsCode": "const results = [];\nlet i = 0;\nfor (const item of $input.all()) {\n  if (item.binary && item.binary.data) {\n    try {\n      const binaryData = await this.helpers.getBinaryDataBuffer(i, 'data');\n      const str = binaryData.toString('utf8');\n      const parsed = JSON.parse(str);\n      \n      if (Array.isArray(parsed)) {\n        let content = \"Danh sách các bài viết hiện có trên Website:\\n\";\n        for (const post of parsed) {\n          content += `- Tiêu đề: ${post.title} (Đăng ngày ${post.date})\\n  Tóm tắt: ${post.excerpt}\\n`;\n        }\n        results.push({ json: { text: content } });\n      } else {\n        const content = `Tiêu đề bài viết: ${parsed.title}\\nChủ đề: ${(parsed.tags || []).join(', ')}\\n\\nNội dung chi tiết:\\n${parsed.content}`;\n        results.push({ json: { text: content } });\n      }\n    } catch (error) {\n      throw new Error(`Lỗi khi đọc file ${item.json[\"File Name\"]}: ${error.message}`);\n    }\n  }\n  i++;\n}\nreturn results;"
      },
